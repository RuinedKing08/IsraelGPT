  m_TableData:
  - m_Id: 1001
    m_Localized: TLS Dungeon
    m_Metadata:
      m_Items: []
  - m_Id: 1002
    m_Localized: A branching text adventure where every decision leaves a mark on the dungeon.
    m_Metadata:
      m_Items: []
  - m_Id: 1003
    m_Localized: Start Adventure
    m_Metadata:
      m_Items: []
  - m_Id: 1004
    m_Localized: Quit
    m_Metadata:
      m_Items: []
  - m_Id: 1005
    m_Localized: Language
    m_Metadata:
      m_Items: []
  - m_Id: 1006
    m_Localized: ES
    m_Metadata:
      m_Items: []
  - m_Id: 1007
    m_Localized: EN
    m_Metadata:
      m_Items: []
  - m_Id: 1008
    m_Localized: By Sergio, Mateo, Juan, Milton and Oscar
    m_Metadata:
      m_Items: []
  - m_Id: 1009
    m_Localized: Enter your name
    m_Metadata:
      m_Items: []
  - m_Id: 1010
    m_Localized: The dungeon will remember every decision. Write the name that will face this journey.
    m_Metadata:
      m_Items: []
  - m_Id: 1011
    m_Localized: Press Enter to continue
    m_Metadata:
      m_Items: []
