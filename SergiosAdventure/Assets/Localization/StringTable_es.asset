  m_TableData:
  - m_Id: 1001
    m_Localized: La Mazmorra de TLS
    m_Metadata:
      m_Items: []
  - m_Id: 1002
    m_Localized: Una aventura de texto ramificada donde cada decision deja huella en la mazmorra.
    m_Metadata:
      m_Items: []
  - m_Id: 1003
    m_Localized: Iniciar aventura
    m_Metadata:
      m_Items: []
  - m_Id: 1004
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 1005
    m_Localized: Idioma
    m_Metadata:
      m_Items: []
  - m_Id: 1006
    m_Localized: ES
    m_Metadata:
      m_Items: []
  - m_Id: 1007
    m_Localized: EN
    m_Metadata:
      m_Items: []
  - m_Id: 1008
    m_Localized: Por Sergio, Mateo, Juan, Milton y Oscar
    m_Metadata:
      m_Items: []
  - m_Id: 1009
    m_Localized: Escribe tu nombre
    m_Metadata:
      m_Items: []
  - m_Id: 1010
    m_Localized: La mazmorra recordara cada decision. Ingresa el nombre con el que enfrentaras esta travesia.
    m_Metadata:
      m_Items: []
  - m_Id: 1011
    m_Localized: Presiona Enter para continuar
    m_Metadata:
      m_Items: []
  - m_Id: 1012
    m_Localized: Nombre del aventurero
    m_Metadata:
      m_Items: []
  - m_Id: 1013
    m_Localized: 'Aventurero: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1014
    m_Localized: 'Vida: {0}/{1}'
    m_Metadata:
      m_Items: []
